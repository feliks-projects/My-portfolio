from datetime import datetime


tasks = [
    {
        "id": 1,
        "title": "Finish portfolio",
        "priority": "high",
        "completed": False,
        "created_at": "2026-09-20"
    },
    {
        "id": 2,
        "title": "Test Python project",
        "priority": "medium",
        "completed": True,
        "created_at": "2026-09-21"
    },
    {
        "id": 3,
        "title": "Update README",
        "priority": "low",
        "completed": False,
        "created_at": "2026-09-22"
    },
    {
        "id": 4,
        "title": "Fix authentication bug",
        "priority": "high",
        "completed": False,
        "created_at": "2026-09-23"
    }
]


def get_pending_tasks(tasks):
    return [
        task
        for task in tasks
        if not task["completed"]
    ]


def get_tasks_by_priority(tasks, priority):
    return [
        task
        for task in tasks
        if task["priority"] == priority
    ]


def calculate_statistics(tasks):
    total = len(tasks)

    completed = sum(
        1 for task in tasks
        if task["completed"]
    )

    pending = total - completed

    if total > 0:
        completion_rate = completed / total * 100
    else:
        completion_rate = 0

    return {
        "total": total,
        "completed": completed,
        "pending": pending,
        "completion_rate": round(completion_rate, 2)
    }


def add_task(tasks, title, priority):
    allowed_priorities = {"low", "medium", "high"}

    title = title.strip()

    if not title:
        raise ValueError("Task title cannot be empty")

    if priority not in allowed_priorities:
        raise ValueError(f"Invalid priority: {priority}")

    existing_ids = [
        task["id"]
        for task in tasks
    ]

    next_id = max(existing_ids, default=0) + 1

    new_task = {
        "id": next_id,
        "title": title,
        "priority": priority,
        "completed": False,
        "created_at": datetime.now().strftime("%Y-%m-%d")
    }

    tasks.append(new_task)

    return new_task


def print_report(tasks):
    statistics = calculate_statistics(tasks)

    print("\n=== TASK REPORT ===")
    print(f"Total tasks: {statistics['total']}")
    print(f"Completed: {statistics['completed']}")
    print(f"Pending: {statistics['pending']}")
    print(f"Completion rate: {statistics['completion_rate']}%")

    print("\nHigh priority tasks:")

    high_priority = get_tasks_by_priority(tasks, "high")

    if not high_priority:
        print("No high priority tasks.")
        return

    for task in high_priority:
        status = "DONE" if task["completed"] else "PENDING"
        print(f"[{status}] {task['title']}")


def main():
    try:
        add_task(
            tasks,
            "Prepare GitHub repository",
            "medium"
        )

        print_report(tasks)

        pending = get_pending_tasks(tasks)

        print("\nPending tasks:")

        for task in pending:
            print(f"- {task['title']}")

    except ValueError as error:
        print(f"Error: {error}")


if __name__ == "__main__":
    main()
